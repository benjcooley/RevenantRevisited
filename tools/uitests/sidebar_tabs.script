# Sidebar tab-click smoke test.
# Pair with: --test=ui-hud --headless --filmstrip=8,0
#   --input-script="$(cat tools/uitests/sidebar_tabs.script)"
#
# Default output: ./filmstrips/001-NNN-<label>.png + ./filmstrips/filmstrip-001.png
# Override with --snapprefix=<path or name>
#
# 8 manual-mode captures, each labeled (label appears in filename + drawn
# on the scaled cell in the composite with a black drop shadow):
#   1. baseline
#   2. after upper Book   click
#   3. after upper Stats  click
#   4. after upper Equip  click
#   5. after lower Spell  click
#   6. after lower Inv    click
#   7. after lower Map    click
#   8. final
#
# Tab button screen coords (Classic 640x480 reference):
#   strip x=580, y=24; per-button at (583, 26+37*i); width 36, height 35
#   centers x=601, y in {43, 80, 117, 154, 191, 228}

log baseline;
moveto 100 100 0; pause 400; take_snapshot baseline;

log click_upper_book;
moveto 601 43 200; pause 100; left_down; pause 80; left_up; pause 250; take_snapshot click upper Book;

log click_upper_stats;
moveto 601 80 200; pause 100; left_down; pause 80; left_up; pause 250; take_snapshot click upper Stats;

log click_upper_equip;
moveto 601 117 200; pause 100; left_down; pause 80; left_up; pause 250; take_snapshot click upper Equip;

log click_lower_spell;
moveto 601 154 200; pause 100; left_down; pause 80; left_up; pause 250; take_snapshot click lower Spell;

log click_lower_inv;
moveto 601 191 200; pause 100; left_down; pause 80; left_up; pause 250; take_snapshot click lower Inv;

log click_lower_map;
moveto 601 228 200; pause 100; left_down; pause 80; left_up; pause 250; take_snapshot click lower Map;

log final;
pause 200; take_snapshot final

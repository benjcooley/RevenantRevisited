// The Forest
AREA "The Forest"
BEGIN
  CDPLAYLIST TRACKS 3 4
  LEVEL 0
  AMBLIGHT 30
  AMBCOLOR 250, 250, 250
  NIGHTAMBLIGHT 35
  NIGHTAMBCOLOR 75, 100, 255
  SCRIPT "forest.s"
  AUDIOENV 0
END



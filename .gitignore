# Build output
/build
/bin
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/build.ninja
/Makefile
/Testing/

# Reference copies (kept locally, not tracked)
/legacy
# Hand-extracted contents of data/resources.rvr and data/Modules/*.rvm —
# kept local for grepping; the .rvr/.rvm archives are authoritative.
/data/resources_unzipped
/data/Modules/Ahkuilon_unzipped

# Editor / OS
.DS_Store
.vscode/ipch
.vscode/.browse.c_cpp.db*

# Aider
.aider*

# Env / secrets
.env

# Python
__pycache__/
*.pyc
*.pyo

# Generated at root
/compile_commands.json

# Runtime artifacts written to cwd when running Revenant from repo root
/*.log
/*.pid
/*.o
/imgui.ini
/Revenant.ini
# Sector saves the running game writes with a literal-backslash
# "curmap\name.DAT" filename (path-separator bug). Show up at repo
# root when running ./Revenant from source, and under data/curmap\\
# when running ./build/Revenant.
/curmap\\*.DAT
/data/curmap\\*.DAT

# Runtime-modified game state — not original game assets. These mutate
# during gameplay/testing. Originals come from the stock GOG install at
# the user's path; new-game initialization repopulates them as needed.
/data/Curmap
/data/Save

# Backup / temp
*~
*.bak

# ASan / sanitizer build dir (sibling to /build, opt-in via -DREVENANT_ASAN=ON)
/build-asan

# Claude Code per-project session files
/.claude

/build-smk

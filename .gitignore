# Build output
/build
/build-*/
/bin
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/build.ninja
/Makefile
/Testing/
# CI step records and packages (tools/ci/ci.py)
/ci-out/
/dist/

# Reference copies (kept locally, not tracked)
/legacy
# The developer's own Revenant install (data/README.md): never committed.
/data/*
!/data/README.md
# Reverse-engineering workspace (Ghidra output, class maps, pipeline): kept
# local, never committed.
/recon/
# Per-session VFX agent logs.
/.vfx_logs/

# Editor / OS
.DS_Store
.vscode/ipch
.vscode/.browse.c_cpp.db*

# Aider
.aider*

# Env / secrets
.env

# Python
__pycache__/
*.pyc
*.pyo

# Generated at root
/compile_commands.json

# Runtime artifacts written to cwd when running Revenant from repo root
/*.log
/*.pid
/*.o
/imgui.ini
/Revenant.ini

# Backup / temp
*~
*.bak

# ASan / sanitizer build dir (sibling to /build, opt-in via -DREVENANT_ASAN=ON)
/build-asan

# Claude Code per-project session files (ignore everything EXCEPT shared skills)
/.claude/*
!/.claude/skills/

# Headless test output (auto-generated by --filmstrip / --snap)
/filmstrips/

# Retail recon output and validation artifacts are generated locally.
/recon/retail_asm/baseline
/recon/retail_asm/experiments
/recon/retail_asm/runtime
/recon/retail_asm/variants
/build-merge/
.venv/
*.pyc
*.so

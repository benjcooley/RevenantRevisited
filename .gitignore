# Build output
/build
/bin
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/build.ninja
/Makefile
/Testing/

# Reference copies (kept locally, not tracked)
/legacy

# Editor / OS
.DS_Store
.vscode/ipch
.vscode/.browse.c_cpp.db*

# Aider
.aider*

# Env / secrets
.env

# Python
__pycache__/
*.pyc
*.pyo

# Generated at root
/compile_commands.json

# Runtime artifacts written to cwd when running Revenant from repo root
/*.log
/*.pid
/*.o
/imgui.ini
/Revenant.ini
# Sector saves the running game writes with a literal-backslash
# "curmap\name.DAT" filename (path-separator bug). Authoritative
# sector data lives under data/curmap/ and IS tracked.
/curmap\\*.DAT

# Backup / temp
*~
*.bak

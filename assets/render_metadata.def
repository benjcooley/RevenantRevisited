HELPER "Box"
BEGIN
  IMAGERY "Misc\box.i3d"
  DRAWABLE mesh

  SUBMESH "hedra01"
  BEGIN
    PASS transparent_world
    BLEND alpha
    LIGHTING lit
    ZTEST true
    ZWRITE false
  END

  // Historical helper shadow/ground plane. Kept explicit so we can tune or
  // replace it without changing the I3D data.
  SUBMESH "rectangle0"
  BEGIN
    PASS transparent_world
    BLEND alpha
    LIGHTING unlit_shadow
    ZTEST true
    ZWRITE false
  END
END

HELPER "Axis"
BEGIN
  IMAGERY "Misc\Axis.i3d"
  DRAWABLE mesh
  PASS transparent_world
  BLEND alpha
  LIGHTING lit
  ZTEST true
  ZWRITE false
END

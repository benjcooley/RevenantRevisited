// Revenant extended render metadata.
//
// This file contains renderer-side policy that is not authored inside I2D/I3D
// imagery resources. It is intentionally separate from gameplay class data:
// instances still own logical state, while drawables use this file to choose
// pass, blend, lighting, texture animation, and special drawable behavior.

// Common pass/blend vocabulary:
//   PASS       opaque_world | transparent_world | overlay
//   BLEND      opaque | alpha | additive
//   LIGHTING   lit | fullbright | vertex_lit | unlit_shadow
//   ZTEST      true | false
//   ZWRITE     true | false

EFFECT "Water"
BEGIN
  IMAGERY "misc\Water.i3d"
  DRAWABLE water_particles
  PASS transparent_world
  BLEND additive
  LIGHTING vertex_lit
  ZTEST true
  ZWRITE false
  TEXTURE_ANIM frame_by_instance
END

EFFECT "Waterfall"
BEGIN
  IMAGERY "misc\Water.i3d"
  DRAWABLE waterfall_particles
  PASS transparent_world
  BLEND additive
  LIGHTING vertex_lit
  ZTEST true
  ZWRITE false
  TEXTURE_ANIM frame_by_instance
END


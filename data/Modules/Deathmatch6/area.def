// MULTIPLAYER


// Dungeon Level 102
AREA "Stairway to Death"
BEGIN
  CDPLAYLIST TRACKS 5
  LEVEL 102
  AMBLIGHT 4
  AMBCOLOR 255, 255, 255
  SCRIPT "multiplayer.s"
  AUDIOENV 13	// EAX_ENVIRONMENT_STONECORRIDOR
END



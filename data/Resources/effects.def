// Revenant Revisited particle/effect definitions.
//
// First-pass format: simple key/value blocks. Values are intentionally strings
// and scalar fields for now; later graph/editor tooling can emit the same text.

effect TorchFlame
{
    debug = normal
    inactive_ttl_pulses = 12

    bucket flame_billboard
    {
        texture_slot = 0
        atlas_cols = 4
        atlas_rows = 2
        atlas_frames = 8
        width = 50.0
        height = 125.0
        scale = 0.5
        blend = additive
        flip_v = true
        chroma_key = [255, 0, 0]
        frame_expr = "frame(time_frame, 13.0)"
        uv_rect_expr = "flipbook(frame(time_frame, 13.0), 4, 2)"
    }

    emitter billboard
    {
        local_pos = [0.0, 0.0, 32.0]

        output flame_billboard
        {
            life = -1.0
        }
    }
}

// B01 TBloodEffect -- engine-particle rework per the resettled forensics
// (B01_TBloodEffect_RENDER_RESETTLED.md). Blood is a particle system with:
//   1) RESPAWN / loop emission   -- one-shot 10-droplet burst (spawn_burst).
//   2) REFLECTION PLANE          -- FLY droplet hits ground (kill_expr fires
//                                   on pos.z <= emit_pos.z) and chains one
//                                   SPLAT particle at the impact point via
//                                   `chain_bucket = "blood_splat"`.
//   3) PER-PARTICLE STAGES       -- modelled as two buckets (FLY + SPLAT)
//                                   per the brief's Option B: no VM
//                                   stage-machine; the chain mechanism
//                                   handles FLY -> SPLAT.
//
// Render-state per the resettled doc:
//   blend_mode = "alpha"          -- the texture loader pre-encodes the
//                                    black keycolor as a 1-bit alpha
//                                    channel (3dimage.cpp ~line 1690).
//                                    Combined with EParticleBlendMode::Alpha
//                                    (SRC_ALPHA / INV_SRC_ALPHA) and the
//                                    FX shader's `discard if (c.a<0.002)`
//                                    edge cleanup, the survivors render
//                                    chroma-keyed opaque dark red.
//   light_mode = "lit_flat"       -- scene-lit grayscale modulation
//                                    (DoLighting analog).
//   depth_mode = "test_no_write"  -- droplets occlude correctly but don't
//                                    break later effects' depth reads.
effect Blood
{
    debug = normal
    inactive_ttl_pulses = 12

    // FLY droplet -- airborne ballistic dark-red sprite. Uses the box01..
    // box04 cells of Misc\Blood.I3D (top half of the 2x2 atlas).
    bucket blood_fly
    {
        imagery_path = "Misc\\Blood.I3D"
        texture_slot = 0
        atlas_cols = 2
        atlas_rows = 2
        atlas_frames = 4
        width = 32.0
        height = 32.0
        scale = 1.0
        blend_mode = "alpha"
        // DIAGNOSTIC: forced Unlit to confirm geometry/texture/chroma path is
        // working in the unlit harness scene. Revert to lit_flat once the
        // harness lights TBloodEffect properly per the resettled doc §6.6.
        light_mode = "unlit"
        depth_mode = "test_no_write"
        // ScreenAligned matches the snapshot's vertical-tipped quad for
        // FLY (RotateX(-90)·RotateZ(-45)). WorldXY would lay it flat on
        // the ground which is wrong for the airborne stage.
        orientation = "screen_aligned"

        // One-shot 10-droplet burst at attach.
        spawn_burst = 10
        // 24 Hz sim cadence matches the snapshot's authoring rate
        // (effectcomp.cpp:1326-1334 integrates pos += vel; vel.z -= 0.37
        // per tick; we run that math here in per-tick units).
        tick_hz = 24
        // No auto-kill -- the reflection-plane kill_expr handles the
        // FLY -> SPLAT transition. (default_life=0 keeps drops alive
        // until they hit ground.)
        default_life = 0.0

        // Reflection-plane chain: on kill_expr fire, spawn one particle
        // in blood_splat using THIS particle's pos + vel as the chain
        // spawn's emit_pos / emit_vel.
        chain_bucket = "blood_splat"

        // Polar-cone spawn at +40 wu above origin (forensics §3
        // kBloodHeightAttack). Horizontal velocity is a random radial
        // cone, upward component gives a ballistic arc. 4-cell atlas
        // pick at spawn selects one of the box01..box04 droplet variants.
        // rot.x = -pi/4 carries the snapshot's RotateZ(-45°) in-plane
        // spin.
        // Snapshot effectcomp.cpp:1229-1232 (BLOOD_VEL=2.0, BLOOD_FLYSCALE=1.0):
        //   vel.{x,y} = BLOOD_VEL * cos/sin(ha) * random(100,300)/100  -> ~[-6,6]
        //   vel.z     = BLOOD_VEL * sin(va) * random(100,300)/100      -> ~[1,6] upward
        //   scl       = 1.0
        spawn_expr = "
            pos = emit_pos + vec3(0, 0, 40);
            vel = vec3(cos(rand(0, 6.2831853)) * (2 + 4 * rand01()),
                       sin(rand(0, 6.2831853)) * (2 + 4 * rand01()),
                       2 + 4 * rand01());
            scale = vec3(8, 8, 1);
            rot.z = -0.7853982;
            frame = floor(rand01() * 4);
            color = vec4(0.8, 0.1, 0.1, 1);
        "

        // 24 Hz tick: pos += vel; vel.xy *= 0.95; vel.z -= 0.37
        // (effectcomp.cpp:1326-1334 verbatim, in per-tick units).
        tick_expr = "
            pos = pos + vel;
            vel.x = vel.x * 0.95;
            vel.y = vel.y * 0.95;
            vel.z = vel.z - 0.37;
        "

        // Reflection plane: droplet hits ground (pos.z falls to or below
        // the spawn-anchor's z = the origin world-z). The chain_bucket
        // mechanism then materializes ONE blood_splat at this impact
        // site. step() returns 1 (kill) when pos.z <= emit_pos.z.
        kill_expr = "step(pos.z, emit_pos.z)"
    }

    // SPLAT decal -- ground-flat dark-red blob, holds peak scale ~1 sec
    // then shrinks. Uses the box05..box08 cells (bottom half of atlas,
    // frame indices 4..7 via `4 + floor(rand01()*4)`).
    bucket blood_splat
    {
        imagery_path = "Misc\\Blood.I3D"
        texture_slot = 0
        atlas_cols = 2
        atlas_rows = 2
        atlas_frames = 4
        width = 32.0
        height = 32.0
        scale = 1.0
        blend_mode = "alpha"
        // DIAGNOSTIC: Unlit (see blood_fly note above).
        light_mode = "unlit"
        depth_mode = "test_no_write"
        // WorldXY = flat on world XY plane, normal +Z (ground decal).
        // Per forensics §7 / A3: SPLAT/SHRINK keep authored facing,
        // which lays flat after the world transform.
        orientation = "world_xy"

        // Driven entirely by the chain from blood_fly -- no self-spawn.
        spawn_burst = 0
        tick_hz = 24
        // SPLAT (1s hold) + SHRINK (~0.4s) ~= 1.4s. The kill_expr handles
        // fine-grained reaping; default_life is the upper bound.
        default_life = 1.6

        // Chain spawn -- emit_pos / emit_vel are the dying FLY droplet's
        // pos / vel. Stamp the splat at impact (snap z to anchor + 2 wu
        // so the decal doesn't z-fight with the floor), peak scale 28.8
        // = ~1.8x the FLY droplet's 16 base (forensics §3
        // kBloodSplatSize=1.8). frame 4..7 picks the splat cells.
        // Snapshot BLOOD_SPLATSIZE=1.8 (peak splat scale, effectcomp.cpp:1169).
        // SPLAT decal sits at impact + small +z lift to avoid floor z-fight.
        spawn_expr = "
            pos = vec3(emit_pos.x, emit_pos.y, emit_pos.z + 2);
            vel = vec3(0, 0, 0);
            scale = vec3(14, 14, 1);
            rot.z = rand(0, 6.2831853);
            frame = 4 + floor(rand01() * 4);
            color = vec4(0.6, 0.08, 0.08, 1);
        "

        // Hold peak 1.8 for ~60% of life, then linearly shrink to 0 over
        // the last 40%. Shrink rate sized so scale reaches ~0 at age01=1:
        //   shrink_total = 1.8 over (0.4 * default_life * tick_hz) = 0.4*1.6*24 = 15.4 ticks
        //   rate ~= 1.8/15.4 ~= 0.12 wu/tick during SHRINK phase.
        tick_expr = "
            scale.x = scale.x - 0.9 * step(0.6, age01);
            scale.y = scale.y - 0.9 * step(0.6, age01);
        "

        // Reap when the splat has shrunk to ~zero.
        kill_expr = "step(scale.x, 0.5)"
    }
}

// M05 TMistEffect -- ambient ascending wisps; steady-state 50-particle
// emitter, respawn-in-place on landing. Migrated from bespoke C++ per
// docs/vfx/VM_EXTENSION_FORENSICS.md Phase 5. Constants 1:1 with the
// retail TMistAnimator forensics body in INVENTORY M05 §1.
effect Mist
{
    debug = normal
    inactive_ttl_pulses = 12

    bucket mist_drops
    {
        imagery_path = "Magic\\mist.i3d"
        texture_slot = 0
        atlas_cols = 1
        atlas_rows = 1
        atlas_frames = 1
        width = 56.0
        height = 56.0
        scale = 1.0
        blend_mode = "additive_straight"
        light_mode = "unlit"
        depth_mode = "test_no_write"
        orientation = "screen_aligned"

        spawn_count = 50
        tick_hz = 24
        default_life = 5.0

        // Retail TMistAnimator constants (effect_old.cpp:11342+):
        //   MIST_LENGTH = 64, MIST_WIDTH = 20, MIST_HEIGHT = 4
        //   vx = random(-L,L)/32 = -2..+2 wu/tick
        //   vy = random(-W,W)/32 = -0.625..+0.625 wu/tick
        //   vz = random(H/2, H) = +2..+4 wu/tick (always upward)
        //   pos.x = random(-L,L)/2 = -32..+32 wu (port widens 3x to ±96)
        //   pos.y = random(-W,W)/2 = -10..+10 wu (port widens 3x to ±30)
        //   pos.z = +5 wu (slightly above origin)
        spawn_expr = "
            pos = emit_pos + vec3(rand(-96, 96), rand(-30, 30), 20);
            vel = vec3(rand(-2, 2), rand(-0.625, 0.625), rand(2, 4));
            scale = vec3(56 * (0.75 + 0.5 * rand01()),
                         56 * (0.75 + 0.5 * rand01()),
                         1);
            rot.x = 0;
            frame = 0;
            color = vec4(0.16, 0.18, 0.22, 1);
        "

        // RIPPLE_GRAVITY = 0.37 per-tick (shared with H03/H04). tick_hz=24
        // means per_tick_seconds = 1/24, so vel.z -= 0.37 is per-tick
        // exactly. pos += vel in tick units (wu/tick).
        tick_expr = "
            vel.z = vel.z - 0.37;
            pos = pos + vel;
        "

        // Respawn-in-place when the drop lands. emit_pos.z is the
        // bucket-anchor z (the spawning instance's origin); a drop dies
        // when its z falls to or below that level.
        kill_expr = "step(pos.z, emit_pos.z)"
    }
}

CLASS "Player" FORMAT "Page1"
BEGIN
  LINEHEIGHT 12
  LINEWRAP none

  BUTTON "page1" 63 108 25 14
  BUTTON "page2" 89 108 29 14
  BUTTON "trainstrn" 24 120 62 12
  BUTTON "traincons" 24 132 62 12
  BUTTON "trainagil" 24 144 62 12
  BUTTON "trainrflx" 24 156 62 12
  BUTTON "trainmind" 24 168 62 12
  BUTTON "trainluck" 24 180 62 12

  COLOR 255 240 215
  COLOR aqua 113 187 255
  COLOR teal 95 228 193
//COLOR red 255 43 43    // old red was hard to read... bumped it up a bit
  COLOR red 255 150 150
  COLOR blue 110 160 255
  COLOR green 6 221 0
  COLOR yellow 255 247 73

  POS 28 62
  TEXT "Name: "
  FIELD aqua name
  
  NEXTLINE
  TEXT "Class: "
  FIELD aqua class
  
  NEXTLINE
  TEXT "Lvl: "
  FIELD teal level
  TEXT " Exp: "
  FIELD teal exp
  TEXT " Nxt: "
  FIELD teal nextexp

  NEXTLINE
  TEXT "Hlth: "
  FIELD red health
  TEXT red "/"
  FIELD red maxhealth
  TEXT " Mana: "
  FIELD blue mana
  TEXT blue "/"
  FIELD blue maxmana

  NEXTLINE
  TAB 40
  TEXT green "Stats"
  TEXT "/Skills"

  NEXTLINE
  TAB 12
  FIELD right trainstrn
  TAB 14
  TEXT "Strn"
  TAB 56
  FIELD right strn
  TAB 70
  FIELD "Dmg" strnmod1
  FIELD " Hit" strnmod2

  NEXTLINE
  TAB 12
  FIELD right traincons
  TAB 14
  TEXT "Cons"
  TAB 56
  FIELD right cons
  TAB 70
  FIELD "Hlth" consmod1
  FIELD " Ftg" consmod2

  NEXTLINE
  TAB 12
  FIELD right trainagil
  TAB 14
  TEXT "Agil"
  TAB 56
  FIELD right agil
  TAB 70
  FIELD "Atk" agilmod1

  NEXTLINE
  TAB 12
  FIELD right trainrflx
  TAB 14
  TEXT "Rflx"
  TAB 56
  FIELD right rflx
  TAB 70
  FIELD "Def" rflxmod1

  NEXTLINE
  TAB 12
  FIELD right trainmind
  TAB 14
  TEXT "Mind"
  TAB 56
  FIELD right mind
  TAB 70
  FIELD "Mana " mindmod1
  FIELD " Spl " mindmod2

  NEXTLINE
  TAB 12
  FIELD right trainluck
  TAB 14
  TEXT "Luck"
  TAB 56
  FIELD right luck
  TAB 70
  FIELD "Rolls " luckmod1

  NEXTLINE
  TEXT "Armor: "
  FIELD yellow armor
  TEXT " Dmg: "
  FIELD yellow damage


//  NEXTLINE
//  LINEWRAP 150
//  TEXT "Atck: "
//  FIELD atckmod1
//  FIELD atckmod2
//  FIELD atckmod3
//  FIELD atckmod4
//  FIELD atckmod5
//  FIELD atckmod6
//  LINEWRAP none
//  TAB 145
//  FIELD right attackpct

//  NEXTLINE
//  LINEWRAP 150
//  TEXT "Def: "
//  FIELD defmod1
//  FIELD defmod2
//  FIELD defmod3
//  FIELD defmod4
//  FIELD defmod5
//  FIELD defmod6
//  LINEWRAP none
//  TAB 145
//  FIELD right defensepct

END

CLASS "Player" FORMAT "Page2"
BEGIN
  LINEHEIGHT 12
  LINEWRAP none

  BUTTON "page1" 63 108 25 14
  BUTTON "page2" 89 108 29 14

  COLOR 255 240 215
  COLOR aqua 113 187 255

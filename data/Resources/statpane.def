  NEXTLINE
  TAB 10
  TEXT "Hands"
  TAB 68
  FIELD right hands
  TAB 76
  FIELD handsexp
  TEXT "/"
  FIELD handsnxtexp

  NEXTLINE
  TAB 10
  TEXT "Sword"
  TAB 68
  FIELD right sword
  TAB 76
  FIELD swordexp

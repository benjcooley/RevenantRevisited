  TEXT "/"
  FIELD axesnxtexp

  NEXTLINE
  TAB 10
  TEXT "Bows"
  TAB 68
  FIELD right bows
  TAB 76
  FIELD bowsexp
  TEXT "/"
  FIELD bowsnxtexp

  NEXTLINE
  TAB 10
  TEXT "Lockpick"
  TAB 68
  FIELD right lockpick
  TAB 76
  FIELD lockpickexp
  TEXT "/"
  FIELD lockpicknxtexp
END

CLASS "Character"
BEGIN
  LINEHEIGHT 12
  LINEWRAP none

  BUTTON "Prev" 27 250 25 14
  BUTTON "Next" 143 250 29 14

  COLOR 255 240 215
  COLOR aqua 113 187 255
  COLOR teal 95 228 193
  COLOR red 255 43 43
  COLOR blue 97 110 255
  COLOR green 6 221 0
  COLOR yellow 255 247 73

  POS 28 62
  TAB 27
  TEXT right "Name: "
  TAB 27
  FIELD aqua name
  
  NEXTLINE
  TAB 82
  ICON

  TAB 27
  TEXT right "Type: "
  TAB 27
  FIELD aqua objclass
  
  NEXTLINE
  TAB 27
  TEXT right "Level: "
  TAB 27
  FIELD aqua value

  NEXTLINE
  TAB 60
  TEXT right "Experience: "
  TAB 60
  FIELD aqua experience

  NEXTLINE
  TAB 60
  TEXT right "Attack Skill: "
  TAB 60
  FIELD aqua attack

  NEXTLINE
  TAB 60
  TEXT right "Defense Skill: "
  TAB 60
  FIELD aqua defense

  NEXTLINE

  TEXT "Description:"
  NEXTLINE
  TAB 10
  FIELD multipage 135 100 objdesc

  POS 27 250
  TEXT grayable "Prev"
  POS 143 250
  TEXT grayable "Next"

END


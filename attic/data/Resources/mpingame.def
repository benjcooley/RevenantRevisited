PANEL "playlistpanel"
BEGIN

// Main frame
  FRAME POS 40 80 560 265

// Chat frame
//  FRAME POS 40 353 465 90

// Module/Host names
  TEXT POS 30 43 170 18 TEXT "Module" FLAGS TEXTFLAG_CENTER
  TEXT POS 400 43 200 18 TEXT "Host" FLAGS TEXTFLAG_CENTER
  TEXT POS 30 59 170 18 NAME "modulename" FLAGS TEXTFLAG_CENTER
  TEXT POS 400 59 200 18 NAME "hostname" FLAGS TEXTFLAG_CENTER
  TEXT POS 215 59 90 18 NAME "gamepasstxt" TEXT "Game Pass:" FLAGS TEXTFLAG_RIGHT
  TEXT POS 305 59 100 18 NAME "gamepass"

// Standerd exit buttons
  BUTTON POS 520 353 70 27 NAME "logout" TEXT "Log Out"
  BUTTON POS 520 385 70 27 NAME "Resume" TEXT "Resume"
  BUTTON POS 520 417 70 27 NAME "dedicated" TEXT "Ded.Srvr"

// Player List Tags
  LISTBOX POS 50 110 380 190 NAME "playerlist" FIELD "playerfield" FLAGS LISTFLAG_VLIST | LISTFLAG_USEFORMAT ITEM 1000 28 SELCOLOR 0 112 74\
  FONT "small" COLOR 255 255 255 FLAGS TEXT_CENTER | TEXT_VCENTER | TEXT_SHADOW | TEXT_SINGLELINE DRAWMODE DM_USEDEFAULT
  BEGIN
    BITMAP 3  3 "smallicon" DRAWMODE DM_TRANSPARENT
	BITMAP 2  2 "miniring" DRAWMODE DM_ALPHA
	FIELD 28 0 75 13 FLAGS TEXT_LEFT | TEXT_SHADOW "pl_name"
	FIELD 28 12 75 13 FLAGS TEXT_LEFT | TEXT_SHADOW "pl_party"
	FIELD 95 0 55 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_class"
	FIELD 95 12 55 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_level"
	FIELD 150 0 35 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_status"
	FIELD 185 0 35 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_online"
	FIELD 220 0 25 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_pk"
	FIELD 245 0 25 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_view"
	TEXT 278 0 15 13 FLAGS TEXT_LEFT | TEXT_SHADOW "Plr"
	TEXT 273 12 18 13 FLAGS TEXT_LEFT | TEXT_SHADOW "Mon"
	FIELD 294 0 28 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_plkills"
	FIELD 294 12 28 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_mnkills"
	FIELD 322 0 28 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_plwaskilled"
	FIELD 322 12 28 13 FLAGS TEXT_CENTER | TEXT_SHADOW "pl_mnwaskilled"
  END

// Player list description line
  TEXT POS 80 95 70 14 NAME "txtnameparty" TEXT "Name/Party" FONT "Small" 
  TEXT POS 150 95 70 14 NAME "txtclasslevel" TEXT "Class/Level" FONT "Small" 
  TEXT POS 206 95 50 14 NAME "txtstatus" TEXT "Status" FONT "Small" 
  TEXT POS 242 95 35 14 NAME "txtonline" TEXT "Online" FONT "Small" 
  TEXT POS 274 95 35 14 NAME "txtpk" TEXT "PKer" FONT "Small" 
  TEXT POS 301 95 35 14 NAME "txtview" TEXT "View" FONT "Small" 
  TEXT POS 350 95 25 14 NAME "txtpfrg" TEXT "Kills" FONT "Small" 
  TEXT POS 375 95 30 14 NAME "txtpkill" TEXT "Killed" FONT "Small" 

// Player status
//  TEXT POS 444 93 113 20 TEXT "Player Status"
//  DROPLIST POS 445 115 113 20 NAME "plyrstatus" FIELD "plyrstatus" LISTHEIGHT 76

// Party stuff
  FRAME POS 440 110 149 190 BITMAP "ClearFrame2"
  TEXT POS 442 117 90 20 TEXT "Party Name"
  EDIT POS 445 140 137 20 NAME "partyname" TEXT "My Party"
  TEXT POS 442 164 117 20 TEXT "Party Password"
  EDIT POS 446 186 84 20 NAME "partypass" TEXT "FOOZLE"
  BUTTON POS 448 218 100 20 NAME "partyclosed" TEXT "Party Closed" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE

  TEXT POS 442 240 44 19 TEXT "Color"
  DROPLIST POS 489 240 94 20 NAME "partycolor" FLAGS DROPFLAG_USEFORMAT LISTHEIGHT 76
  BEGIN
    BITMAP 0  0 "partycolor"
	FIELD 0 -2 75 18 FLAGS TEXT_LEFT | TEXT_SHADOW "partycolor"
  END
    
  BUTTON POS 449 270 61 23 NAME "newparty" TEXT "New"
  BUTTON POS 520 270 61 23 NAME "joinparty" TEXT "Join"
  BUTTON POS 449 270 130 23 NAME "leaveparty" TEXT "Leave"

  BUTTON POS 460 90 120 20 NAME "gameclosed" TEXT "Game Closed" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 447 306 147 18 NAME "beeponchat" TEXT "Beep on Chat Msgs" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 447 324 147 18 NAME "plyrkiller" TEXT "Player Killer" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE

// Player control buttons
  BUTTON POS 47 310 59 27 NAME "edit" TEXT "Edit" 
  BUTTON POS 112 310 59 27 NAME "view" TEXT "View" 
  BUTTON POS 177 310 59 27 NAME "save" TEXT "Save" 
  BUTTON POS 242 310 59 27 NAME "accept" TEXT "Accept" 
  BUTTON POS 307 310 59 27 NAME "reject" TEXT "Reject" 
  BUTTON POS 372 310 59 27 NAME "userinfo" TEXT "Info" 

//  LISTBOX POS 45 360 440 80 NAME "chatlist" FIELD "playerfield" FLAGS LISTFLAG_VLIST | LISTFLAG_USEFORMAT ITEM 1000 32 SELCOLOR 0 112 74\
//    FONT "small" COLOR 255 255 255 FLAGS TEXT_CENTER | TEXT_VCENTER | TEXT_SHADOW | TEXT_SINGLELINE DRAWMODE DM_USEDEFAULT
//  BEGIN
//	FIELD 0 0 400 12 FLAGS TEXT_LEFT | TEXT_SHADOW "chatmsg"
//  END
//
//  EDIT POS 45 450 440 18 NAME "chatedit"

// Player List Tags
  LISTBOX POS 40 353 465 70 NAME "chatlist" FIELD "chatlist" FLAGS LISTFLAG_VLIST | LISTFLAG_USEFORMAT | LISTFLAG_VIEWONLY ITEM 1000 12\
    FONT "small" COLOR 255 255 255 FLAGS TEXT_CENTER | TEXT_VCENTER | TEXT_SHADOW | TEXT_SINGLELINE DRAWMODE DM_USEDEFAULT
  BEGIN
	FIELD 0 0 430 12 FLAGS TEXT_LEFT | TEXT_SHADOW "chatmsg"
  END

  EDIT POS 43 428 458 16 NAME "chatedit" TEXT "" FLAGS EDITFLAG_ENTERMSG\
	FONT "small" RECT 4 1 6 1 COLOR 255 255 255 EDITCOLOR 255 255 0 FLAGS TEXT_LEFT | TEXT_SHADOW | TEXT_VCENTER DRAWMODE DM_USEDEFAULT\
	MAXLEN 100

END


# Writes buildinfo.h: the git commit the binary was built from, for the
# playtest recordings' headers (docs/playtest/PROTOCOL.md §4). Run at every
# build (the buildinfo target); the header changes only when the commit or
# the dirty state does, so nothing rebuilds otherwise.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<path>/buildinfo.h -P BuildInfo.cmake

execute_process(COMMAND git rev-parse HEAD
                WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE BUILD_SHA OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE SHA_RESULT)
execute_process(COMMAND git rev-parse --abbrev-ref HEAD
                WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE BUILD_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET)
execute_process(COMMAND git status --porcelain --untracked-files=no
                WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE BUILD_DIRTY OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET)

if(NOT SHA_RESULT EQUAL 0 OR BUILD_SHA STREQUAL "")
  set(BUILD_SHA "unknown")
  set(BUILD_NAME "unknown")
else()
  string(SUBSTRING "${BUILD_SHA}" 0 8 BUILD_SHORT)
  set(BUILD_NAME "${BUILD_BRANCH}@${BUILD_SHORT}")
  if(NOT BUILD_DIRTY STREQUAL "")
    string(APPEND BUILD_NAME "-dirty")
  endif()
endif()

set(CONTENT "// Generated by cmake/BuildInfo.cmake at build time; do not edit.
#pragma once
inline constexpr const char* kBuildSha  = \"${BUILD_SHA}\";
inline constexpr const char* kBuildName = \"${BUILD_NAME}\";
")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE "${OUTPUT}" "${CONTENT}")
endif()

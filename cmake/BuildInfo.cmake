# Writes buildinfo.h: the git commit the binary was built from, for the
# playtest recordings' headers (docs/playtest/PROTOCOL.md §4), and the
# version the main menu shows. Run at every build (the buildinfo target);
# the header changes only when one of its values does, so nothing rebuilds
# otherwise.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<path>/buildinfo.h [-DVERSION=vX.Y.Z]
#         -P BuildInfo.cmake
#
# VERSION is the tag CI claimed for this build (docs/CI.md §6). Without it
# the version is the vX.Y.Z tag on HEAD, else the newest one HEAD descends
# from plus "-dev", else v0.0.0-dev.

function(git_output out)
  execute_process(COMMAND git ${ARGN}
                  WORKING_DIRECTORY "${SOURCE_DIR}"
                  OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE
                  ERROR_QUIET RESULT_VARIABLE result)
  if(result EQUAL 0)
    set(${out} "${value}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

git_output(BUILD_SHA rev-parse HEAD)
# CI checks out the commit, not the branch; it names the branch instead.
if(DEFINED ENV{GITHUB_REF_NAME} AND NOT "$ENV{GITHUB_REF_NAME}" STREQUAL "")
  set(BUILD_BRANCH "$ENV{GITHUB_REF_NAME}")
else()
  git_output(BUILD_BRANCH rev-parse --abbrev-ref HEAD)
endif()
git_output(BUILD_DIRTY status --porcelain --untracked-files=no)

if(BUILD_SHA STREQUAL "")
  set(BUILD_SHA "unknown")
  set(BUILD_SHORT "unknown")
  set(BUILD_NAME "unknown")
else()
  string(SUBSTRING "${BUILD_SHA}" 0 7 BUILD_SHORT)
  string(SUBSTRING "${BUILD_SHA}" 0 8 BUILD_SHORT8)
  set(BUILD_NAME "${BUILD_BRANCH}@${BUILD_SHORT8}")
  if(NOT BUILD_DIRTY STREQUAL "")
    string(APPEND BUILD_NAME "-dirty")
  endif()
endif()

if(VERSION)
  set(BUILD_VERSION "${VERSION}")
else()
  git_output(BUILD_VERSION describe --tags --exact-match --match "v[0-9]*" HEAD)
  if(BUILD_VERSION STREQUAL "")
    git_output(BASE_VERSION describe --tags --abbrev=0 --match "v[0-9]*" HEAD)
    if(BASE_VERSION STREQUAL "")
      set(BASE_VERSION "v0.0.0")
    endif()
    set(BUILD_VERSION "${BASE_VERSION}-dev")
  endif()
endif()

set(CONTENT "// Generated by cmake/BuildInfo.cmake at build time; do not edit.
#pragma once
inline constexpr const char* kBuildSha      = \"${BUILD_SHA}\";
inline constexpr const char* kBuildShortSha = \"${BUILD_SHORT}\";
inline constexpr const char* kBuildBranch   = \"${BUILD_BRANCH}\";
inline constexpr const char* kBuildVersion  = \"${BUILD_VERSION}\";
inline constexpr const char* kBuildName     = \"${BUILD_NAME}\";
")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE "${OUTPUT}" "${CONTENT}")
endif()

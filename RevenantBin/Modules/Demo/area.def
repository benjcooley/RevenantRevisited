// Playable Demo Forest 
AREA "The Forest of Ahkuilon"
BEGIN
  LEVEL 10
  AMBLIGHT 30
  AMBCOLOR 250, 250, 250
  NIGHTAMBLIGHT 30
  NIGHTAMBCOLOR 75, 100, 250
  SCRIPT "demo.s"
  AMBSOUND "forest"
  AUDIOENV 15	// EAX_ENVIRONMENT_FOREST
END


//Playable Demo House Interiors
Area "House Interiors"
BEGIN	
  LEVEL 12
  AMBLIGHT 4
  AMBCOLOR 250, 250, 250
  SCRIPT "demo.s"
  AMBSOUND "bar"
  AUDIOENV 4	// EAX_ENVIRONMENT_LIVINGROOM
END


// Caves
AREA "The Caverns"
BEGIN
  LEVEL 30
  AMBLIGHT 12
  AMBCOLOR 155, 155, 210
  SCRIPT "demo.s"
  AMBSOUND "cave"
  AUDIOENV 8	// EAX_ENVIRONMENT_CAVE
END
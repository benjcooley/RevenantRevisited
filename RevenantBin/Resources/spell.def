// Revenant - Copyright 1998 Cinematix Studios, Inc.
// *********** Revenant SPELL DEF File  ************

// contains all the spell info

// Command List
// Start a spell with: SPELL "name"

// then BEGIN it
// when done END it

// #defines to macro define text

// talismans
// "Sun" = A
// "Life" = B
// "Ocean" = C
// "Law" = D
// "Soul" = E
// "Stars" = F
// "Death" = G
// "Chaos" = H
// "Sky" = I
// "Earth" = J
// "Ward" = K
// "Moon" = L
// "Rubert" = M		// This is now reserved for Enemy Spells - Pepper
// "Gilmor" = N		// This is now reserved for Fizzel - Pepper
// "Barry" = O

// damage types
#define DT_NONE		-1		// Does no damage whatsoever
#define DT_MISC		0		// Just damage (no specific type)
#define DT_HAND		1		// Damage from hand to hand combat
#define DT_PUNCTURE 2		// Puncture damage (arrows, knives and swords thrusts)
#define DT_CUT		3		// Cutting or slashing damage (knive and sword swings)
#define DT_CHOP		4		// Chopping damage (knive, sword, or axe chops)
#define DT_BLUDGEON 5       // Bludgeoning damage (warhammers, clubs, maces)
#define DT_MAGICAL  6       // Magical damage (other than any that fit below)
#define DT_BURN     7       // Burn damage (i.e. lava, fileball, etc.)
#define DT_FREEZE   8       // Freeze damage (i.e. frost, etc.)
#define DT_POISON   9		// Poison damage


#define SOFTWARE_TIMED		-1


// spell flags
#define SF_NONE		0x0000

// variant types
#define TP_BASIC	3

// conditionals
#define TRUE		1
#define FALSE		0






// LEVEL 1 SPELLS


SPELL "Fire Flash"
BEGIN
	NAME "Fire Flash"
	ICONNAME "Fire Flash"
	DESCRIPTION "Eat the new cheetos, fire poofs!"
	DAMAGETYPE DT_BURN
	ANIMATION "invoke1"
	DELAY 5
	LIGHT COLOR 255, 130, 0 INT 160 MULT 20
	FLAGS SF_NONE

//	NAME, TYPE, TALISMANS, EFFECT_NAME, MANA, WAIT_NEXT, MIN_D, MAX_D, SKILL, HEIGHT, FACING, LOOP_TIME

	VARIANT "Fire Flash", TP_BASIC, "LI", "fireflash", 31, 50, 50, 55, 1, 0, FALSE, 50
	CONTROLDATA "Strike"
	BEGIN
		PATTERN "circle"
		RADIUS 1
		HITTARGET
		HITS 1
		FOLLOW
  	END

	VARIANT "Priest Fire Flash", TP_BASIC, "MA", "fireflash", 186, 50, 56, 68, 0, 0, FALSE, 50
	CONTROLDATA "Strike"
	BEGIN
		PATTERN "circle"
		RADIUS 20
		HITTARGET
		HITS 2
		FOLLOW
  	END
END




SPELL "Poison"
BEGIN
	NAME "Poison"
	ICONNAME "Poison"
	DESCRIPTION "whats YOUR poison"
	DAMAGETYPE DT_POISON
	ANIMATION "invoke1"
	DELAY 5
	LIGHT COLOR 50, 255, 50 INT 120 MULT 20
	POISONCHANCE 90
	FLAGS SF_NONE

//	NAME, TYPE, TALISMANS, EFFECT_NAME, MANA, WAIT_NEXT, MIN_D, MAX_D, SKILL, HEIGHT, FACING, LOOP_TIME

	VARIANT "Poison", TP_BASIC, "L", "StrikeEffect", 42, 20, 0, 2, 1, 0, FALSE, 20
	CONTROLDATA "Strike"
	BEGIN
		HITTARGET
		DURATION 1080 24
		HITTARGET
		FOLLOW
		PLAYONCE "poison"
		IMAGERY "magic\PoisonCloud.i3d"
	END

	VARIANT "SpiderPoison", TP_BASIC, "MC", "StrikeEffect", 10, 1, 10, 20, 0, 0, FALSE, 1
	CONTROLDATA "Strike"
	BEGIN
		HITTARGET
		DURATION 1080 24
		HITTARGET
		FOLLOW
		PLAYONCE "poison"
		IMAGERY "magic\PoisonCloud.i3d"
	 END
END





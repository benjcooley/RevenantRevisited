SPELL "Might"
BEGIN
	ICONNAME "Might"
	DESCRIPTION "Oh my gawd, my hands are on fire!"
	DAMAGETYPE DT_NONE
	NAME "Might" 
	ANIMATION "invoke4"
	DELAY 5
	FLAGS SF_NONE
	LIGHT COLOR 255, 160, 0 INT 120 MULT 10

//	NAME, TYPE, TALISMANS, EFFECT_NAME, MANA, WAIT_NEXT, MIN_D, MAX_D, SKILL, HEIGHT, FACING, LOOP_TIME

	VARIANT "Might", TP_BASIC, "E", "StrikeEffect", 31, 20, 0, 0, 3, 40, FALSE, 20
	CONTROLDATA "Strike" 
	BEGIN
		IMAGERY "magic\might.i3d"
		FOLLOW 
		PLAY "fist"
		DURATION 2880 24
		HITS 2
		ATTACHMULTIPLE "lhand" "rhand"
		STATLINE STRN 2 TIME 2880
	END
END





SPELL "Fist Mastery"
BEGIN
	ICONNAME "Fist Mastery"
	DESCRIPTION "Hah! Your kungfu is weak. As well as obsolete. Prepare to die. Hmmpf!"
	DAMAGETYPE DT_NONE
	NAME "Fist Mastery" 
	ANIMATION "invoke4"
	DELAY 5
	FLAGS SF_NONE
	LIGHT COLOR 255,120,0 INT 120 MULT 10

//	NAME, TYPE, TALISMANS, EFFECT_NAME, MANA, WAIT_NEXT, MIN_D, MAX_D, SKILL, HEIGHT, FACING, LOOP_TIME

	VARIANT "Fist Mastery", TP_BASIC, "BE", "StrikeEffect", 50, 20, 0, 0, 3, 50, FALSE, 20
	CONTROLDATA "Strike" 
	BEGIN
		IMAGERY "magic\fmaster.i3d"
		FOLLOW 
		DURATION 2880 24
		HITS 2
		PLAY "fist"
		ATTACHMULTIPLE "lhand" "rhand"
		STATLINE HANDS 4 TIME 2880
	END
END




// LEVEL 2 SPELLS




SPELL "Meteor Storm"
BEGIN
	NAME "Meteor Storm"
	ICONNAME "Meteor Storm"
	DESCRIPTION "A mighty blow from above."
	DAMAGETYPE DT_BURN
	ANIMATION "invoke2"
	DELAY 5
	LIGHT COLOR 255, 180, 0 INT 180 MULT 20
	FLAGS SF_NONE

//	NAME, TYPE, TALISMANS, EFFECT_NAME, MANA, WAIT_NEXT, MIN_D, MAX_D, SKILL, HEIGHT, FACING, LOOP_TIME

	VARIANT "Meteor Storm", TP_BASIC, "JI", "StrikeEffect", 53, 70, 74, 94, 4, 100, FALSE, 70
	CONTROLDATA "Strike"
	BEGIN
		IMAGERY "magic\Comet.i3d"
		RADIUS 265
		PLAY "meteorstorm"
		WAIT 48
		HITS 4
		PATTERN "random"
		DURATION 93 0
		RANGEDAMAGE 150 30
	END

	VARIANT "Priest Meteor Storm", TP_BASIC, "MD", "StrikeEffect", 80, 70, 92, 122, 0, 100, FALSE, 70
	CONTROLDATA "Strike"
	BEGIN
		IMAGERY "magic\Comet.i3d"
		RADIUS 265
		PLAY "meteorstorm"
		WAIT 48
		HITS 12
		PATTERN "random"
		DURATION 93 0
		RANGEDAMAGE 150 25
	END
END





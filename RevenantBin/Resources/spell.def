// SPELL "Swift Strike" [CL] mana 61, +13 fatigue per sec for 10 secs, invoke skill 5
SPELL "Swift Strike"
BEGIN
	ICONNAME "Swift Strike"
	DESCRIPTION "What you need is a swift kick in the head."
	NAME "Swift Strike"
	DAMAGETYPE DT_NONE	
	ANIMATION "invoke4"
	DELAY 5
	LIGHT COLOR 255, 120, 0 INT 120 MULT 20
	FLAGS SF_NONE

//	NAME, TYPE, TALISMANS, EFFECT_NAME, MANA, WAIT_NEXT, MIN_D, MAX_D, SKILL, HEIGHT, FACING, LOOP_TIME

	VARIANT "Swift Strike", TP_BASIC, "CL", "StrikeEffect", 61, 20, 0, 0, 5, 0, FALSE, 20
	CONTROLDATA "Strike"
	BEGIN
		IMAGERY "magic\SwiftStrike.i3d"
		FOLLOW 
		DURATION 650 24
		POS 0 0 0
		STATLINE FATIGUEPCT 780 TIME 650
	END
END





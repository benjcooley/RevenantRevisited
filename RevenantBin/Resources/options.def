PANEL "default"
BEGIN


// Options
// Toggle Buttons
  BUTTON POS 55 60 250 20 NAME "Realtime" TEXT "Enable Real Time Lights" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 55 80 250 20 NAME "Auto" TEXT "Automatically Begin Combat" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 55 100 250 20 NAME "Dialog" TEXT "Play Audio Dialog" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 55 120 250 20 NAME "Face" TEXT "Always Face Enemy In Combat" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 55 140 250 20 NAME "Enhanced" TEXT "Use Enhanced 3D Lighting" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 55 160 250 20 NAME "Limit" TEXT "Limit Game Speed" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE
  BUTTON POS 55 180 250 20 NAME "NoCombatRes" TEXT "No Combat Results" FLAGS BTNFLAG_TOGGLE | BTNFLAG_DRAWTOGGLE

// Sliders
  TEXT POS 260 70 150 20 TEXT "Violence Level" FLAGS TEXT_SHADOW | TEXTFLAG_RIGHT
  TEXT POS 260 103 150 20 TEXT "Music Volume" FLAGS TEXT_SHADOW | TEXTFLAG_RIGHT 
  TEXT POS 260 136 150 20 TEXT "SFX Volume" FLAGS TEXT_SHADOW | TEXTFLAG_RIGHT 
  TEXT POS 260 169 150 20 TEXT "Gamma Level" FLAGS TEXT_SHADOW | TEXTFLAG_RIGHT 

  SCROLLBAR POS 420 70 160 20 NAME "Violence" FLAGS SCROLLFLAG_HSCROLL
  SCROLLBAR POS 420 103 160 20 NAME "Music" FLAGS SCROLLFLAG_HSCROLL
  SCROLLBAR POS 420 136 160 20 NAME "Sound" FLAGS SCROLLFLAG_HSCROLL
  SCROLLBAR POS 420 169 160 20 NAME "Gamma" FLAGS SCROLLFLAG_HSCROLL


// Controller Config
//  FRAME POS 50 200 530 200
  TEXT POS 70 200 100 20 TEXT "Control Name"
  TEXT POS 300 200 60 20 TEXT "Key 1"
  TEXT POS 455 200 60 20 TEXT "Key 2"
//  TEXT POS 480 200 60 20 TEXT "Key 3"

  LISTBOX POS 60 220 512 170 NAME "controller" FLAGS LISTFLAG_VLIST | LISTFLAG_USEFORMAT | CTRLFLAG_CLEARBG RECT 185 5 23 5 ITEM 150 20 SELCOLOR 0 100 30\
  FONT "Med" COLOR 255 255 255 FLAGS TEXT_CENTER | TEXT_VCENTER | TEXT_SHADOW | TEXT_SINGLELINE DRAWMODE DM_USEDEFAULT
  BEGIN
	FIELD 0 0 150 20 FONT "Med" FLAGS TEXT_SHADOW | TEXT_CENTER COLOR 255 255 100 "key"
  END

  TEXT POS 70 224 180 20 NAME "name0" TEXT "Up" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER
  TEXT POS 70 244 180 20 NAME "name1" TEXT "Down" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER
  TEXT POS 70 264 180 20 NAME "name2" TEXT "Left" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER
  TEXT POS 70 284 180 20 NAME "name3" TEXT "Right" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER
  TEXT POS 70 304 180 20 NAME "name4" TEXT "Punch" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER
  TEXT POS 70 324 180 20 NAME "name5" TEXT "Kick" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER
  TEXT POS 70 344 180 20 NAME "name6" TEXT "Thrust" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER
  TEXT POS 70 364 180 20 NAME "name7" TEXT "Use" FLAGS CTRLFLAG_CLEARBG FONT "Med" FLAGS TEXT_LEFT | TEXT_VCENTER

//  FRAME POS 60 220 512 170

// Screen Control
  BUTTON POS 180 410 100 30 NAME "ok" TEXT "OK"
  BUTTON POS 360 410 100 30 NAME "cancel" TEXT "Cancel"

END




